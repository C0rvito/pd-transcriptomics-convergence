879', '9606.ENSP00000358765', '9606.ENSP00000347942', '9606.ENSP00000387075', '9606.ENSP00000449404', '9606.ENSP00000362294', '9606.ENSP00000364683', '9606.ENSP00000398632', '9606.ENSP00000369889', '9606.ENSP00000365280', '9606.ENSP00000379140', '9606.ENSP00000366246', '9606.ENSP00000392495', '9606.ENSP00000266085', '9606.ENSP00000391826', '9606.ENSP00000321106', '9606.ENSP00000369976', '9606.ENSP00000369895', '9606.ENSP00000416330', '9606.ENSP00000437621', '9606.ENSP00000222390', '9606.ENSP00000371420', '9606.ENSP00000355896', '9606.ENSP00000311697', '9606.ENSP00000284984', '9606.ENSP00000321797', '9606.ENSP00000297848', '9606.ENSP00000360973', '9606.ENSP00000267377', '9606.ENSP00000392423', '9606.ENSP00000264664', '9606.ENSP00000226218', '9606.ENSP00000267584', '9606.ENSP00000310829', '9606.ENSP00000422591', '9606.ENSP00000346839']}
