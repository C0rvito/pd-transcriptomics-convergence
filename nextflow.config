nextflow.enable.dsl = 2

// ---------------------------------------------------------------------------
// Parameters – all paths and tool settings centralised here.
// Override on the CLI: nextflow run workflows/main.nf --threads 16
// ---------------------------------------------------------------------------
params {
    // Input reads: expected layout  data/reads/raw/<GENE>/files/<SRR>_{1,2}.fastq.gz
    reads_dir    = "${projectDir}/data/reads/raw"

    // Reference files (pre-built STAR index assumed to exist)
    star_index   = "${projectDir}/data/reference/STAR_Index"
    gtf          = "${projectDir}/data/reference/GRCh38_GENCODE_v45/gencode.v45.primary_assembly.annotation.gtf"
    genome_fasta = "${projectDir}/data/reference/GRCh38_GENCODE_v45/GRCh38.primary_assembly.genome.fa"

    // Root output directory – sub-paths are managed by each module
    outdir = "${projectDir}/data"

    // Thread count (applied to all multi-threaded tools)
    threads = 8

    // fastp quality-filtering options
    fastp_qual       = 20
    fastp_unqual_pct = 40
    fastp_min_len    = 50

    // STAR read-length parameter (sjdbOverhang = read_length - 1)
    star_overhang = 149
}

// ---------------------------------------------------------------------------
// Docker – use official nf-core/biocontainer images per process
// ---------------------------------------------------------------------------
docker {
    enabled    = true
    runOptions = '--rm'
}

// ---------------------------------------------------------------------------
// Per-process resource and container configuration
// Regex patterns handle DSL2 module aliases (e.g. FASTQC_RAW / FASTQC_TRIMMED)
// ---------------------------------------------------------------------------
process {
    withName: ~/.*FASTQC.*/ {
        container = 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0'
        cpus      = { params.threads }
        memory    = '4 GB'
    }
    withName: 'FASTP' {
        container = 'quay.io/biocontainers/fastp:0.23.4--hadf994f_2'
        cpus      = { params.threads }
        memory    = '8 GB'
    }
    withName: 'STAR_ALIGN' {
        container = 'quay.io/biocontainers/star:2.7.11b--h43eeafb_0'
        cpus      = { params.threads }
        memory    = '40 GB'
    }
    withName: 'STAR_INDEX' {
        container = 'quay.io/biocontainers/star:2.7.11b--h43eeafb_0'
        cpus      = 23
        memory    = '64 GB'
    }
    withName: 'MULTIQC' {
        container = 'quay.io/multiqc/multiqc:v1.21'
        cpus      = 2
        memory    = '4 GB'
    }
}

// ---------------------------------------------------------------------------
// Manifest
// ---------------------------------------------------------------------------
manifest {
    name            = 'pd-transcriptomics-convergence'
    description     = 'RNA-seq preprocessing and alignment pipeline for PD transcriptomics'
    version         = '1.0.0'
    nextflowVersion = '>=23.04'
}
